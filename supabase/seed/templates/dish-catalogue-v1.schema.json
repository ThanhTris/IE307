      },
      "required": [
        "id",
        "type",
        "code",
        "label",
        "description",
        "status",
        "origin",
        "version",
        "reviewStatus",
        "sourceRef",
        "fieldSources",
        "checkedAt",
        "validUntil",
        "enteredBy",
        "reviewedBy"
      ],
      "additionalProperties": false
    },
    "dataSources": {
      "type": "object",
      "properties": {
        "sourceRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "ID ổn định UUIDv5 từ registry key bất biến"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "URL/file nguồn có thể truy vết"
        },
        "usageRights": {
          "type": "string",
          "enum": [
            "unknown",
            "granted",
            "licensed",
