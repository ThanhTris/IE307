        "reviewStatus": {
          "type": "string",
          "enum": [
            "draft",
            "verified",
            "published"
          ],
          "description": "Trạng thái kiểm dữ liệu; khác trạng thái đang bán"
        },
        "fieldSources": {
          "type": "object",
