# GM-03 local tooling does not read project secrets or connect to a remote project.
# Public platform API: http://127.0.0.1:54321
# Database: loopback port 54322; credentials are local CLI-managed defaults.
# No access token/service_role here. Do not paste status raw output into Git/evidence.
# GM-16 rate-limit probe: the GoTrue image expects a trusted proxy key for the
# token bucket. `scripts/gm16_rate_limit_setup.ps1` applies this to the local
# Auth container after `backend:start`; never expose this value to clients.
GOTRUE_RATE_LIMIT_HEADER=X-Forwarded-For
