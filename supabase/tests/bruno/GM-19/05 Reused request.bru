meta {
  name: 05 Reused request
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/rest/v1/rpc/create_room
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{createId}}","display_name":"changed","anchor_id":"{{anchorId}}","radius_m":1500,"desired_at":"{{desiredAt}}","service_mode":"dine_in","meal_slot":"dinner","time_hint":null,"budget":null,"avoid_recent":false}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) {  }
}
tests {
  test('05 Reused request status and contract',()=>{
    expect(res.getStatus()).to.equal(409);

    expect(res.getBody().messageKey).to.equal('REQUEST_ID_REUSED');

  });
}
