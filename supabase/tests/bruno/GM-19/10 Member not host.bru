meta {
  name: 10 Member not host
  type: http
  seq: 10
}
post {
  url: {{baseUrl}}/rest/v1/rpc/start_round
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{memberToken}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}","room_id":"{{roomId}}","expected_version":{{roomVersion}}}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) {  }
}
tests {
  test('10 Member not host status and contract',()=>{
    expect(res.getStatus()).to.equal(403);

    expect(res.getBody().messageKey).to.equal('NOT_HOST');

  });
}
