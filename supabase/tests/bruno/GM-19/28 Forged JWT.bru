meta {
  name: 28 Forged JWT
  type: http
  seq: 28
}
post {
  url: {{baseUrl}}/rest/v1/rpc/get_room_snapshot
  body: json
  auth: none
}
headers {
  Authorization: Bearer invalid.token
  Content-Type: application/json
}
body:json {
  {"room_id":"{{roomId}}"}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) {  }
}
tests {
  test('28 Forged JWT status and contract',()=>{
    expect(res.getStatus()).to.equal(401);



  });
}
