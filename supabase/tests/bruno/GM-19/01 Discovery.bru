meta {
  name: 01 Discovery
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/rest/v1/rpc/get_discovery_context
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) {  }
}
tests {
  test('01 Discovery status and contract',()=>{
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);

    expect(res.getBody().data.anchors).to.have.lengthOf(1);
  });
}
