meta {
  name: 26 Invalid input
  type: http
  seq: 26
}
post {
  url: {{baseUrl}}/rest/v1/rpc/join_room
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}","code":"bad","display_name":"x"}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) {  }
}
tests {
  test('26 Invalid input status and contract',()=>{
    expect(res.getStatus()).to.equal(400);

    expect(res.getBody().messageKey).to.equal('INVALID_INPUT');

  });
}
