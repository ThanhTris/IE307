meta {
  name: 07 Join member
  type: http
  seq: 7
}
post {
  url: {{baseUrl}}/rest/v1/rpc/join_room
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{memberToken}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}","code":"{{roomCode}}","display_name":"Bruno member"}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) { bru.setVar('roomVersion',body.version); }
}
tests {
  test('07 Join member status and contract',()=>{
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);

    expect(res.getBody().data.memberId).to.be.a('string');
  });
}
