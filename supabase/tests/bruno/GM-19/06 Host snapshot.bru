meta {
  name: 06 Host snapshot
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/rest/v1/rpc/get_room_snapshot
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"room_id":"{{roomId}}"}
}
script:pre-request {
  bru.setVar('requestId','xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);}));

}
script:post-response {
  const body=res.getBody();
  if(res.getStatus()===200 && body.ok===true) {  }
}
tests {
  test('06 Host snapshot status and contract',()=>{
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);

    expect(res.getBody().data.members).to.have.lengthOf(1);expect(res.getBody().data.members[0].ready).to.equal(false);expect(res.getBody().data.pool.length).to.be.above(0);
  });
}
