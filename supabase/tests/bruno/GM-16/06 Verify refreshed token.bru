meta {
  name: 06 Verify refreshed token
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/auth/v1/user
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test('Refreshed access token resolves the same caller', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id === bru.getVar('guestId')).to.equal(true);
  });
}
