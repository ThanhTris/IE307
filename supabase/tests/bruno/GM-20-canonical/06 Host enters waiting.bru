meta {
  name: 06 Host enters waiting
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/rest/v1/rpc/dish_session
  body: json
  auth: none
}
headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"command":"waiting","payload":{"contractVersion":"dish-session-v4/roadmap-v2/GM-07.B-supplement","roomId":"{{roomId}}","requestId":"canonical-host-wait-{{runId}}","expectedVersion":{{roomVersion}},"round":1,"poolVersion":{{poolVersion}}}}
}
script:post-response {
  const b=res.getBody();
  if(res.getStatus() === 200 && b.ok === true) { bru.setVar('roomVersion',b.version); }
  else bru.runner.stopExecution();
}
tests {
  test('06 Host enters waiting',()=>{const b=res.getBody();expect(res.getStatus()).to.equal(200);expect(b.ok).to.equal(true);});
}
