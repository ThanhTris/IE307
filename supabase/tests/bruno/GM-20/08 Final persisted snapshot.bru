meta {
  name: 08 Final persisted snapshot
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/rest/v1/rpc/get_room_snapshot
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"room_id": "{{roomId}}"}
}
script:pre-request {

}
script:post-response {
  const b=res.getBody();if(res.getStatus()===200) {  }
}
tests {
  test('08 Final persisted snapshot',()=>{expect(res.getStatus()).to.equal(200);const b=res.getBody();expect(b.data.result.reasonCode).to.equal('ACCEPTABLE_FINAL');expect(b.data.result.matchTier).to.equal('COMPROMISE');expect(b.data.round).to.equal(2);expect(b.data.result).not.to.have.property('seed');expect(b.data.result).not.to.have.property('candidateIds');});
}
