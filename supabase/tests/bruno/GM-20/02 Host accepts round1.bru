meta {
  name: 02 Host accepts round1
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/rest/v1/rpc/submit_ballot
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestHost}}","room_id":"{{roomId}}","round":{{rn}},"pool_version":{{pv}},"intent_id":"{{intentHost}}","expected_version":{{hostEv}},"votes":{{votes}}}
}
script:pre-request {
  const attempt='bruno_'+Date.now()+'_'+Math.random();bru.setVar('attempt',attempt);bru.setVar('intent','i_'+attempt);bru.setVar('hostEv',bru.getVar('version'));
}
script:post-response {
  const b=res.getBody();if(res.getStatus()===200) { bru.setVar('version',b.version);bru.setVar('hostAck',JSON.stringify(b)); }
}
tests {
  test('02 Host accepts round1',()=>{expect(res.getStatus()).to.equal(200);const b=res.getBody();expect(b.data.accepted).to.equal(true);expect(b.data.allMembersSubmitted).to.equal(false);expect(b.data.receipt.requestId).to.equal(b.requestId);});
}
