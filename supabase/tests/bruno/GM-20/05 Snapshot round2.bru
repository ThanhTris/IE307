meta {
  name: 05 Snapshot round2
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/rest/v1/rpc/get_room_snapshot
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"room_id": "{{roomId}}"}
}
script:pre-request {

}
script:post-response {
  const b=res.getBody();if(res.getStatus()===200) { bru.setVar('version',b.data.version);bru.setVar('pv',b.data.poolVersion);bru.setVar('rn',2);bru.setVar('votes',JSON.stringify(b.data.pool.map(p=>({roundDishId:p.roundDishId,vote:'KEEP'})))); }
}
tests {
  test('05 Snapshot round2',()=>{expect(res.getStatus()).to.equal(200);const b=res.getBody();expect(b.data.round).to.equal(2);expect(b.data.ownSubmission).to.equal(null);expect(Object.keys(b.data.ownVotes)).to.have.lengthOf(0);});
}
