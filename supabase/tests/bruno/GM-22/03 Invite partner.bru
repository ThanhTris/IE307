meta {
  name: 03 Invite partner
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/rest/v1/rpc/invite_partner
  body: json
}
headers {
  Authorization: Bearer {{hostToken}}
  apikey: {{anonKey}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}","friend_code":"{{memberFriendCode}}","partner_id":null}
}
tests {
  test('friend invite is pending',()=>{ expect(res.getStatus()).to.equal(200); expect(res.body.ok).to.equal(true); expect(res.body.data.status).to.equal('pending'); });
}
script:post-response {
  bru.setEnvVar('friendInvitationId', res.body.data.id);
}
