meta {
  name: 06 Accept room invite
  type: http
  seq: 7
}
post {
  url: {{baseUrl}}/rest/v1/rpc/accept_room_invite
  body: json
}
headers {
  Authorization: Bearer {{memberToken}}
  apikey: {{anonKey}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}-room-accept","invitation_id":"{{roomInvitationId}}","display_name":"GM22 member"}
}
tests {
  test('recipient accepts room invite and gets a membership identity',()=>{ expect(res.getStatus()).to.equal(200); expect(res.body.ok).to.equal(true); expect(res.body.data.memberId).to.match(/^[0-9a-f-]{36}$/i); });
}
script:post-response {
  bru.setEnvVar('acceptedRoomVersion', res.body.data.version);
  bru.setEnvVar('acceptedMemberId', res.body.data.memberId);
}
