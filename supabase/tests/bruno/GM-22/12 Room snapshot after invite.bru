meta {
  name: 12 Room snapshot after invite
  type: http
  seq: 12
}
post {
  url: {{baseUrl}}/rest/v1/rpc/dish_session
  body: json
}
headers {
  Authorization: Bearer {{memberToken}}
  apikey: {{anonKey}}
  Content-Type: application/json
}
body:json {
  {"command":"snapshot","payload":{"contractVersion":"dish-session-v4/roadmap-v2/GM-07.B","roomId":"{{roomId}}"}}
}
tests {
  test('member reads same B room and roster contains both identities',()=>{ expect(res.getStatus()).to.equal(200); expect(res.body.ok).to.equal(true); expect(res.body.data.members.length).to.equal(2); expect(res.body.data.members.some(member=>member.userId===bru.getEnvVar('memberId'))).to.equal(true); });
}
