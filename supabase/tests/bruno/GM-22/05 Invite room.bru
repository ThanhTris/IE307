meta {
  name: 05 Invite room
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/rest/v1/rpc/invite_to_room
  body: json
}
headers {
  Authorization: Bearer {{hostToken}}
  apikey: {{anonKey}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}-room","room_id":"{{roomId}}","partner_id":"{{memberId}}","expected_version":{{roomVersion}}}
}
tests {
  test('room invite is pending and does not join recipient',()=>{ expect(res.getStatus()).to.equal(200); expect(res.body.ok).to.equal(true); expect(res.body.data.status).to.equal('pending'); });
}
script:post-response {
  bru.setEnvVar('roomInvitationId', res.body.data.id);
}
