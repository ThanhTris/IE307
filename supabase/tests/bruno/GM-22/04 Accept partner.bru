meta {
  name: 04 Accept partner
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/rest/v1/rpc/accept_partner
  body: json
}
headers {
  Authorization: Bearer {{memberToken}}
  apikey: {{anonKey}}
  Content-Type: application/json
}
body:json {
  {"requestId":"{{requestId}}-accept","invitation_id":"{{friendInvitationId}}"}
}
tests {
  test('recipient accepts friend invite',()=>{ expect(res.getStatus()).to.equal(200); expect(res.body.ok).to.equal(true); expect(res.body.data).to.equal(null); });
}
