meta {
  name: 08 Inbox
  type: http
  seq: 9
}
post {
  url: {{baseUrl}}/rest/v1/rpc/list_partner_inbox
  body: json
}
headers {
  Authorization: Bearer {{memberToken}}
  apikey: {{anonKey}}
  Content-Type: application/json
}
body:json {
  {"cursor":null}
}
tests {
  test('member inbox identifies the room invitation',()=>{ expect(res.getStatus()).to.equal(200); expect(res.body.some(item=>item.type==='room_invite'&&item.metadata.invitationId===bru.getEnvVar('roomInvitationId'))).to.equal(true); });
}
