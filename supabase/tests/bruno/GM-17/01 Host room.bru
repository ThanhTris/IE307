meta {
  name: 01 Host room
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/rest/v1/rooms?select=id,state,version
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{hostToken}}
}

tests {
  test('Host room', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array").with.lengthOf(1);
  });
}
