meta {
  name: 05 Host own ballots
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/rest/v1/votes?select=id,value
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{hostToken}}
}

tests {
  test('Host own ballots', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array").with.lengthOf(1);
  });
}
