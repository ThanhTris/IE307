meta {
  name: 17 Room direct update
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/rest/v1/rooms?id=eq.{{roomId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}

body:json {
  state: CANCELLED
}

tests {
  test('Room direct update denied', function () {
    const status = res.getStatus();
    expect([204, 403]).to.include(status);
    if (status === 403) expect(res.getBody().code).to.equal("42501");
  });
}
