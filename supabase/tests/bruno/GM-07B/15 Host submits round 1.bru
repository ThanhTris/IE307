meta {
  name: 15 Host submits round 1
  type: http
  seq: 15
}
post {
  url: {{baseUrl}}/rest/v1/rpc/dish_session
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"command":"submit","payload":{"contractVersion":"dish-session-v4/roadmap-v2/GM-07.B","requestId":"r1_host_{{timestamp}}","roomId":"{{roomId}}","expectedVersion":{{roomVersion}},"round":1,"poolVersion":{{poolVersion}},"votes":{{r1Votes}}}}
}
script:pre-request {
  bru.setVar('timestamp', String(Date.now()));
  bru.setVar('hostR1RequestId', 'r1_host_' + bru.getVar('timestamp'));
}
script:post-response {
  const b = res.getBody();
  if (res.getStatus() === 200 && b.ok) { bru.setVar('roomVersion', String(b.version)); bru.setVar('hostR1Receipt', JSON.stringify(b)); }
}
tests {
  test('Complete ballot is acknowledged and does not start waiting by itself', () => {
    const b = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(b.ok).to.equal(true);
    expect(b.data.accepted).to.equal(true);
    expect(b.data.round).to.equal(1);
  });
}
