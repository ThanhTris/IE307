meta {
  name: 01 Host guest
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/auth/v1/signup
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"data":{"display_name":"V4 Bruno Host","gm07_v4_qa":"dish-v4-qa-20261026"}}
}
script:post-response {
  const b = res.getBody();
  if (res.getStatus() === 200 && b.access_token) { bru.setVar('hostToken', b.access_token); bru.setVar('hostId', b.user.id); }
  else bru.runner.stopExecution();
}
tests {
  test('Creates a real anonymous host identity', () => {
    const b = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(b.user.is_anonymous).to.equal(true);
    expect(b.access_token).to.be.a('string').and.not.empty;
  });
}
