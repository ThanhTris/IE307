meta {
  name: 02 Member guest
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/auth/v1/signup
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"data":{"display_name":"V4 Bruno Member","gm07_v4_qa":"dish-v4-qa-20261026"}}
}
script:post-response {
  const b = res.getBody();
  if (res.getStatus() === 200 && b.access_token) { bru.setVar('memberToken', b.access_token); bru.setVar('memberId', b.user.id); }
  else bru.runner.stopExecution();
}
tests {
  test('Creates a distinct anonymous member identity', () => {
    const b = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(b.user.is_anonymous).to.equal(true);
    expect(b.user.id).not.to.equal(bru.getVar('hostId'));
  });
}
