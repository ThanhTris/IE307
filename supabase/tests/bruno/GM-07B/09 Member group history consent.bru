meta {
  name: 09 Member group history consent
  type: http
  seq: 9
}
post {
  url: {{baseUrl}}/rest/v1/rpc/update_history_consent
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{memberToken}}
  Content-Type: application/json
}
body:json {
  {"requestId":"member_group_{{timestamp}}","scope":"group","consent":true}
}
script:pre-request {
  bru.setVar('timestamp', String(Date.now()));
}
tests {
  test('Member explicitly opts in to group history', () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);
  });
}
