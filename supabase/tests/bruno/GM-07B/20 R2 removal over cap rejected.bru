meta {
  name: 20 R2 removal over cap rejected
  type: http
  seq: 20
}
post {
  url: {{baseUrl}}/rest/v1/rpc/dish_session
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{hostToken}}
  Content-Type: application/json
}
body:json {
  {"command":"submit","payload":{"contractVersion":"dish-session-v4/roadmap-v2/GM-07.B","requestId":"r2_overcap_{{timestamp}}","roomId":"{{roomId}}","expectedVersion":{{roomVersion}},"round":2,"poolVersion":{{poolVersion}},"votes":{{r2VotesOverCap}}}}
}
script:pre-request {
  bru.setVar('timestamp', String(Date.now()));
}
tests {
  test('R2 rejects cap plus one without accepting a partial ballot', () => {
    const b = res.getBody();
    expect(res.getStatus()).to.equal(409);
    expect(b.ok).to.equal(false);
    expect(b.error.messageKey).to.equal('REMOVE_LIMIT');
  });
}
