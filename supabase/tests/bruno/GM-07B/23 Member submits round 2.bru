meta {
  name: 23 Member submits round 2
  type: http
  seq: 23
}
post {
  url: {{baseUrl}}/rest/v1/rpc/dish_session
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{memberToken}}
  Content-Type: application/json
}
body:json {
  {"command":"submit","payload":{"contractVersion":"dish-session-v4/roadmap-v2/GM-07.B","requestId":"r2_member_{{timestamp}}","roomId":"{{roomId}}","expectedVersion":{{roomVersion}},"round":2,"poolVersion":{{poolVersion}},"votes":{{r2VotesKeep}}}}
}
script:pre-request {
  bru.setVar('timestamp', String(Date.now()));
}
script:post-response {
  const b = res.getBody();
  if (res.getStatus() === 200 && b.ok) bru.setVar('roomVersion', String(b.version));
}
tests {
  test('Last complete R2 ballot finalizes once on the server', () => {
    const b = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(b.ok).to.equal(true);
    expect(b.state).to.equal('DECIDED');
  });
}
