  {"requestId":"{{requestIdDenied}}","device_id":"{{deviceId}}","token":"ignored","permission":"denied"}
}
tests {
  test("denied remains usable inbox", function() { expect(res.status).to.equal(200); expect(res.body.ok).to.equal(true); });
}
