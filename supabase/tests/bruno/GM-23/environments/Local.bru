vars {
  baseUrl: http://127.0.0.1:54332
  anonKey: replace-with-local-anon-key
  recipientToken: replace-with-disposable-recipient-jwt
  deviceId: gm23-android-device
  requestId: gm23-register-{{$random.uuid}}
  requestIdDenied: gm23-denied-{{$random.uuid}}
  requestIdUnregister: gm23-unregister-{{$random.uuid}}
  requestIdNoAuth: gm23-no-auth-{{$random.uuid}}
}
