meta {
 name: 21 Replay unregister ACK
 type: http
 seq: 21
}
post {
 url: {{baseUrl}}/rest/v1/rpc/unregister_push_device
 body: json
 auth: none
}
headers {
 apikey: {{anonKey}}
 Authorization: Bearer {{hostToken}}
 Content-Type: application/json
}
body:json {
 {"requestId":"{{unregisterRequestId}}","device_id":"{{deviceId}}"}
}
tests {
 test('same unregister request returns the exact ACK',()=>{expect(res.getStatus()).to.equal(200);expect(JSON.stringify(res.getBody())).to.equal(bru.getVar('unregisterAck'));});
}
