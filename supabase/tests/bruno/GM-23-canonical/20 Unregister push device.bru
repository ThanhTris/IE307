meta {
 name: 20 Unregister push device
 type: http
 seq: 20
}
post {
 url: {{baseUrl}}/rest/v1/rpc/unregister_push_device
 body: json
 auth: none
}
headers {
 apikey: {{anonKey}}
 Authorization: Bearer {{hostToken}}
 Content-Type: application/json
}
body:json {
 {"requestId":"{{unregisterRequestId}}","device_id":"{{deviceId}}"}
}
script:post-response {
 bru.setVar('unregisterAck',JSON.stringify(res.getBody()));
}
tests {
 test('unregister returns the null-data ACK',()=>{expect(res.getStatus()).to.equal(200);expect(res.getBody()).to.deep.equal({ok:true,requestId:bru.getEnvVar('unregisterRequestId'),data:null});});
}
