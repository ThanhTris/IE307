meta {
 name: 12 Canonical inbox
 type: http
 seq: 12
}
post {
 url: {{baseUrl}}/rest/v1/rpc/list_partner_inbox
 body: json
 auth: none
}
headers {
 apikey: {{anonKey}}
 Authorization: Bearer {{hostToken}}
 Content-Type: application/json
}
body:json {
 {"cursor":null}
}
tests {
 test('canonical result is reference-only in own inbox',()=>{expect(res.getStatus()).to.equal(200);const row=res.getBody().find(i=>i.metadata?.resultId===bru.getVar('resultId'));expect(row,'result notification').to.exist;expect(row.type).to.equal('room_result');expect(row.metadata.roomId).to.equal(bru.getEnvVar('roomId'));expect(row.metadata.status).to.equal('DECIDED');expect(row.metadata.eventVersion).to.equal(1);expect(Object.keys(row.metadata).sort()).to.deep.equal(['contractVersion','eventVersion','resultId','roomId','status']);});
}
