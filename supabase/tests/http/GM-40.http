# GM-40 test-demo catalogue via the owned GM-03 Auth + REST + worker stack.
# Execute all requests with scripts/gm40_catalogue_check.py --qa-manifest PATH.
# The runner resolves the gateway and gets a real guest JWT from GoTrue.
# Manual clients can provide the three placeholders from an owned QA run only.
@baseUrl = http://127.0.0.1:QA_API_PORT/rest/v1
@anonKey = QA_ANON_KEY
@guestJwt = QA_GUEST_JWT

### catalogue
# HTTP 200. Exactly 39 stable dishes, rich release/source SHA and testOnly=true.
POST {{baseUrl}}/rpc/get_dish_catalogue
Content-Type: application/json
apikey: {{anonKey}}
Authorization: Bearer {{guestJwt}}

{"payload":{"contractVersion":"dish-catalogue/roadmap-v2/GM-18.2"}}

### lunch
# HTTP 200. Exactly 20 distinct lunch dishes and 23 available.
POST {{baseUrl}}/rpc/preview_dish_pool
Content-Type: application/json
apikey: {{anonKey}}
Authorization: Bearer {{guestJwt}}

{"payload":{"contractVersion":"dish-catalogue/roadmap-v2/GM-18.2","mealSlot":"lunch","dishCount":20}}

### dinner-shortage
# HTTP 409. GM-18.2 wire key INSUFFICIENT_DISHES with available=7 and requested=20.
POST {{baseUrl}}/rpc/preview_dish_pool
Content-Type: application/json
apikey: {{anonKey}}
Authorization: Bearer {{guestJwt}}

{"payload":{"contractVersion":"dish-catalogue/roadmap-v2/GM-18.2","mealSlot":"dinner","dishCount":20}}
