# Data/BE only; synthetic disposable DB as in scripts/dish_policy_sql_check.py.
# baseUrl includes /rest/v1. Use valid hostToken/memberToken from QA auth.
# Every successful response must assert ok=true, exact count/state/version;
# error responses require ok=false + expected messageKey, not just HTTP status.
@baseUrl = http://127.0.0.1:54321/rest/v1
@hostToken = REPLACE_IN_PRIVATE_ENVIRONMENT
@memberToken = REPLACE_IN_PRIVATE_ENVIRONMENT
@roomId = REPLACE_FROM_CREATE
@roomCode = REPLACE_FROM_CREATE
@version = 1

### Host exact count / no GPS or venue; assert pool length15 and distinct dishId
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{"command":"create","payload":{"requestId":"create-unique-1","displayName":"Host","dishCount":15,"mealSlot":"dinner","cuisineIds":[],"categoryIds":[]}}

### Join; assert members <=20; 21st returns ROOM_FULL
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{memberToken}}

{"command":"join","payload":{"requestId":"join-unique-1","code":"{{roomCode}}","displayName":"Member"}}

### Refresh current version after joining
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{"command":"snapshot","payload":{"roomId":"{{roomId}}"}}

### Start; no ready input, waitingStartedAt must remain null
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{"command":"start","payload":{"requestId":"start-unique-1","roomId":"{{roomId}}","expectedVersion":{{version}}}}

### Negative: incomplete object must reject without starting a timer
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{"command":"submit","payload":{"requestId":"incomplete-1","roomId":"{{roomId}}","round":1,"poolVersion":1,"votes":{}}}

### Enter waiting after complete submit: first starts clock, replay cannot extend.
# Complete vote objects and assertions for every pool item are generated by
# scripts/dish_policy_sql_check.py; raw real ballots must never be committed here.
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{"command":"waiting","payload":{"requestId":"waiting-unique-1","roomId":"{{roomId}}","round":1,"poolVersion":1}}

### Host early finalize; requires >=1 complete ballot and current version
POST {{baseUrl}}/rpc/dish_session
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{"command":"finalize","payload":{"requestId":"finalize-unique-1","roomId":"{{roomId}}","expectedVersion":{{version}}}}
