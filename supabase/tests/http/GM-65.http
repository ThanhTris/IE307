@baseUrl = http://127.0.0.1:54621
@anonKey = <owned-QA-public-key>
@userToken = <JWT-of-QA-account>
@serviceKey = <owned-QA-service-role-key>
@installId = 11111111-1111-4111-8111-111111111111
@clientReportId = 22222222-2222-4222-8222-222222222222

# Run only on an isolated GM-03 QA project with migration 0068_gm65_error_reports.sql applied.

### 1. Anonymous user submits valid error report (allowlisted payload)
POST {{baseUrl}}/rest/v1/rpc/report_app_error
apikey: {{anonKey}}
Content-Type: application/json

{
  "payload": {
    "clientReportId": "{{clientReportId}}",
    "installId": "{{installId}}",
    "errorCode": "NETWORK_ERROR",
    "httpStatus": 503,
    "screen": "guest_entry",
    "action": "create_guest",
    "requestId": "req_http_001",
    "appVersion": "1.0.0",
    "platform": "android",
    "osVersion": "14",
    "occurredAt": "2026-11-26T09:00:00.000Z",
    "note": "Smoke test HTTP GM-65",
    "urgent": false
  }
}

> {%
  client.test('Anon valid report returns GCD code', function () {
    client.assert(response.status === 200);
    client.assert(response.body.ok === true);
    client.assert(/^GCD-[A-Z0-9]{10}$/.test(response.body.reportCode));
  });
%}

### 2. Duplicate clientReportId is idempotent (same reportCode)
POST {{baseUrl}}/rest/v1/rpc/report_app_error
apikey: {{anonKey}}
Content-Type: application/json

{
  "payload": {
    "clientReportId": "{{clientReportId}}",
    "installId": "{{installId}}",
    "errorCode": "NETWORK_ERROR",
    "screen": "guest_entry",
    "appVersion": "1.0.0",
    "platform": "android",
    "occurredAt": "2026-11-26T09:00:00.000Z",
    "urgent": false
  }
}

> {%
  client.test('Duplicate clientReportId returns ok without duplicate row', function () {
    client.assert(response.status === 200);
    client.assert(response.body.ok === true);
    client.assert(/^GCD-[A-Z0-9]{10}$/.test(response.body.reportCode));
  });
%}

### 3. Rejects forbidden/unknown key (email / roomCode / token)
POST {{baseUrl}}/rest/v1/rpc/report_app_error
apikey: {{anonKey}}
Content-Type: application/json

{
  "payload": {
    "clientReportId": "33333333-3333-4333-8333-333333333333",
    "installId": "{{installId}}",
    "errorCode": "NETWORK_ERROR",
    "screen": "room/join",
    "appVersion": "1.0.0",
    "platform": "android",
    "occurredAt": "2026-11-26T09:01:00.000Z",
    "urgent": false,
    "roomCode": "ABC123"
  }
}

> {%
  client.test('Forbidden key rejected with INVALID_INPUT', function () {
    client.assert(response.status === 200);
    client.assert(response.body.ok === false);
    client.assert(response.body.messageKey === 'INVALID_INPUT');
  });
%}

### 4. Rejects note exceeding 500 characters
POST {{baseUrl}}/rest/v1/rpc/report_app_error
apikey: {{anonKey}}
Content-Type: application/json

{
  "payload": {
    "clientReportId": "44444444-4444-4444-8444-444444444444",
    "installId": "{{installId}}",
    "errorCode": "USER_FEEDBACK",
    "screen": "profile",
    "appVersion": "1.0.0",
    "platform": "android",
    "occurredAt": "2026-11-26T09:02:00.000Z",
    "urgent": false,
    "note": ""
  }
}

> {%
  client.test('Overlong note rejected with INVALID_INPUT', function () {
    client.assert(response.status === 200);
    client.assert(response.body.ok === false);
    client.assert(response.body.messageKey === 'INVALID_INPUT');
  });
%}

### 5. Authenticated user submits error report
POST {{baseUrl}}/rest/v1/rpc/report_app_error
apikey: {{anonKey}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "payload": {
    "clientReportId": "55555555-5555-4555-8555-555555555555",
    "installId": "66666666-6666-4666-8666-666666666666",
    "errorCode": "TIMEOUT",
    "httpStatus": 504,
    "screen": "room/vote",
    "action": "submit_ballot",
    "requestId": "req_http_002",
    "appVersion": "1.0.0",
    "platform": "android",
    "osVersion": "14",
    "occurredAt": "2026-11-26T09:03:00.000Z",
    "note": "Authenticated user timeout report",
    "urgent": true
  }
}

> {%
  client.test('Authenticated user report accepted', function () {
    client.assert(response.status === 200);
    client.assert(response.body.ok === true);
    client.assert(/^GCD-[A-Z0-9]{10}$/.test(response.body.reportCode));
  });
%}

### 6. Client cannot call operator list RPC (anon / authenticated denied)
POST {{baseUrl}}/rest/v1/rpc/gm65_admin_list_error_reports
apikey: {{anonKey}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{"only_new": true}

> {%
  client.test('Operator RPC denied to authenticated client', function () {
    client.assert(response.status >= 400);
  });
%}

### 7. Client cannot read private table directly via REST
GET {{baseUrl}}/rest/v1/gm65_private.error_reports
apikey: {{anonKey}}
Authorization: Bearer {{userToken}}

> {%
  client.test('Private error_reports table not exposed over REST', function () {
    client.assert(response.status >= 400);
  });
%}

### 8. Service role reads sanitized reports (no reporter_id or install_id returned)
POST {{baseUrl}}/rest/v1/rpc/gm65_admin_list_error_reports
apikey: {{serviceKey}}
Authorization: Bearer {{serviceKey}}
Content-Type: application/json

{"only_new": true}

> {%
  client.test('Service role receives sanitized list without PII/ids', function () {
    client.assert(response.status === 200);
    client.assert(Array.isArray(response.body));
    client.assert(response.body.length >= 1);
    const first = response.body[0];
    client.assert(!('reporter_id' in first) && !('reporterId' in first));
    client.assert(!('install_id' in first) && !('installId' in first));
  });
%}
