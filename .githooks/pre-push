#!/bin/sh
# Validate each committed project snapshot. No legacy report pipeline.
set -eu
PROJECT_PYTHON_COMMAND="${PROJECT_PYTHON:-python}"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  if git cat-file -e "$local_sha:docs/project/MIGRATION_PLAN.md" 2>/dev/null; then
    "$PROJECT_PYTHON_COMMAND" scripts/validate_repository.py --git-tree "$local_sha"
  else
    echo "Historical snapshot: new-project baseline validation not applicable"
  fi
done
