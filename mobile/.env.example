EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: EAS project id, required for remote push (development build, not Expo Go on Android).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional: restricted Google Places key for "Quán gần đây" on the result screen.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Development/QA only, keep unset in production builds:
# EXPO_PUBLIC_PLACES_SIMULATED=1   simulated nearby places on an emulator
# EXPO_PUBLIC_GM29_QA_PUSH=1       local QA notifications against a loopback QA API
