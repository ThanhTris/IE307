EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Environment label injected by EAS Build profiles: development | staging | production
EXPO_PUBLIC_APP_ENV=development
# Optional: EAS project id, required for remote push (development build, not Expo Go on Android).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional: restricted Google Places / Maps Embed key for "Quán gần đây" on the result screen.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Optional: 40-hex uppercase SHA-1 signing cert fingerprint (no colons) sent as X-Android-Cert for app-restricted Places API.
EXPO_PUBLIC_ANDROID_CERT_SHA1=
# Development/QA only, keep unset in production builds:
# EXPO_PUBLIC_PLACES_SIMULATED=1   simulated nearby places on an emulator
# EXPO_PUBLIC_GM29_QA_PUSH=1       local QA notifications against a loopback QA API
