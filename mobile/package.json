{
  "name": "gi-cung-duoc-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:expo": "node scripts/check-expo.mjs",
    "check:expo:latest": "expo install --check",
    "test:expo-baseline": "node --test scripts/check-expo.test.mjs",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:architecture"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "overrides": {
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
