{
  "name": "gi-cung-duoc-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "expo start --go --lan",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:expo": "expo install --check",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:architecture"
  },
  "dependencies": {
    "expo": "57.0.27",
    "expo-constants": "57.0.21",
    "expo-linking": "57.0.12",
    "expo-router": "57.0.25",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "overrides": {
    "react-dom": "19.2.3",
    "react-server-dom-webpack": "19.1.5",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
