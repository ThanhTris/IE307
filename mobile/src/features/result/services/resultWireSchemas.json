    "terminalResult": {
      "type": "object",
      "required": [
        "resultId",
        "contractVersion",
        "policyVersion",
        "status",
        "round",
        "winner",
        "reasonCode",
        "finalizedAt",
        "scoreVersion",
        "rankingVersion",
        "topDishes"
      ],
      "properties": {
        "resultId": {
          "$ref": "#/$defs/uuid"
        },
        "contractVersion": {
          "enum": [
            "dish-session-v4/roadmap-v2/GM-07.B",
            "dish-session-v4/roadmap-v2/GM-07.B-supplement"
          ]
        },
        "policyVersion": {
          "const": "dish-decision-v4/ADR-019-30PCT-MIN1"
        },
        "status": {
          "enum": [
            "DECIDED",
            "NO_CONSENSUS"
          ]
        },
        "round": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "winner": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/poolDish"
            }
          ]
        },
        "reasonCode": {
          "enum": [
            "UNANIMOUS_WANT",
            "ACCEPTABLE_FINAL",
            "EMPTY_INTERSECTION",
            "ALL_REMOVED"
          ]
        },
        "finalizedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "scoreVersion": {
          "oneOf": [
            {
              "const": "want2-ok1-round1-v1"
            },
            {
              "type": "null"
            }
          ]
        },
        "rankingVersion": {
          "oneOf": [
            {
              "const": "score-desc-dense-rank-v1"
            },
            {
              "type": "null"
            }
          ]
        },
        "topDishes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/topDish"
          }
        },
        "round1BallotCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Total complete server-ACKed round-one ballots in the scoring cohort; upper bound for any dish score is 2 * round1BallotCount."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "winner": {
                "$ref": "#/$defs/poolDish"
              },
              "reasonCode": {
                "enum": [
                  "UNANIMOUS_WANT",
                  "ACCEPTABLE_FINAL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NO_CONSENSUS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "winner": {
                "type": "null"
              },
              "reasonCode": {
                "enum": [
                  "EMPTY_INTERSECTION",
                  "ALL_REMOVED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "topDishes": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "isWinner": {
                      "const": true
                    }
                  },
                  "required": [
                    "isWinner"
                  ]
                }
              }
            },
            "not": {
              "properties": {
                "topDishes": {
                  "contains": {
                    "properties": {
                      "isWinner": {
                        "const": true
                      }
                    },
                    "required": [
                      "isWinner"
                    ]
                  },
                  "minContains": 2
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NO_CONSENSUS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "topDishes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NO_CONSENSUS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "scoreVersion": {
                "type": "null"
              },
              "rankingVersion": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "scoreVersion": {
                "const": "want2-ok1-round1-v1"
              },
              "rankingVersion": {
                "const": "score-desc-dense-rank-v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contractVersion": {
                "const": "dish-session-v4/roadmap-v2/GM-07.B-supplement"
              }
            },
            "required": [
              "contractVersion"
            ]
          },
          "then": {
            "required": [
              "round1BallotCount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              }
            },
            "required": [
              "status",
              "round1BallotCount"
            ]
          },
          "then": {
            "properties": {
              "round1BallotCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              },
              "round": {
                "const": 1
              }
            },
            "required": [
              "status",
              "round"
            ]
          },
          "then": {
            "properties": {
              "reasonCode": {
                "const": "UNANIMOUS_WANT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              },
              "round": {
                "const": 2
              }
            },
            "required": [
              "status",
              "round"
            ]
          },
          "then": {
            "properties": {
              "reasonCode": {
                "const": "ACCEPTABLE_FINAL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NO_CONSENSUS"
              },
              "round": {
                "const": 1
              }
            },
            "required": [
              "status",
              "round"
            ]
          },
          "then": {
            "properties": {
              "reasonCode": {
                "const": "EMPTY_INTERSECTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NO_CONSENSUS"
              },
              "round": {
                "const": 2
              }
            },
            "required": [
              "status",
              "round"
            ]
          },
          "then": {
            "properties": {
              "reasonCode": {
                "const": "ALL_REMOVED"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
